library(ggrepel)
#flux and wt% plots with stat outputs
# Get a point along each fitted line to anchor the label to
line_points <- bsi_dat %>%
select(lake, depth, date, wt_percent, flux_mg) %>%
pivot_longer(cols = c(wt_percent, flux_mg), names_to = "name", values_to = "value") %>%
group_by(lake, name) %>%
nest() %>%
mutate(
model = map(data, ~ lm(value ~ date, data = .x)),
at_date = map_dbl(data, ~ median(.x$date, na.rm = TRUE)),
at_value = map2_dbl(model, at_date, ~ predict(.x, newdata = tibble(date = .y)))
) %>%
select(lake, name, date = at_date, value = at_value) %>%
ungroup()
label_dat2 <- trend_summary %>%
left_join(line_points, by = c("lake", "name")) %>%
mutate(name = recode_name(name),
lake = recode_lake(lake),
lake = factor(lake, levels = lake_levels),
sig  = if_else(p.value < 0.05, "*", ""),
label = paste0("R\u00b2 = ", sprintf("%.2f", r.squared),
", p = ", if_else(p.value < 0.001, "<0.001", sprintf("%.3f", p.value)), sig))
plot_dat %>%
ggplot(aes(x = value, y = date)) +
geom_path() +
geom_smooth(method = "lm", orientation = "y", se = FALSE,
color = "firebrick", linewidth = 0.6) +
geom_text_repel(data = label_dat2, aes(x = value, y = date, label = label),
size = 2.6, color = "firebrick", inherit.aes = FALSE,
segment.color = NA, box.padding = 0.4, seed = 42) +
scale_y_continuous(breaks = seq(1850, 2000, 50)) +
facet_grid(rows = vars(lake), cols = vars(name), scales = "free_x", switch = "x") +
theme_bw() +
theme(strip.background = element_blank(),
strip.text.x = element_text(vjust = -1),
panel.grid = element_blank(),
axis.title = element_blank())
label_dat2 <- trend_summary %>%
left_join(line_points, by = c("lake", "name")) %>%
mutate(name = recode_name(name),
lake = recode_lake(lake),
lake = factor(lake, levels = lake_levels),
sig  = if_else(p.value < 0.05, "*", ""),
label = paste0("R\u00b2 = ", sprintf("%.2f", r.squared),
"\np = ", if_else(p.value < 0.001, "<0.001", sprintf("%.3f", p.value)), sig))
plot_dat %>%
ggplot(aes(x = value, y = date)) +
geom_path() +
geom_smooth(method = "lm", orientation = "y", se = FALSE,
color = "firebrick", linewidth = 0.6) +
geom_text_repel(data = label_dat2, aes(x = value, y = date, label = label),
size = 2.6, color = "firebrick", inherit.aes = FALSE,
segment.color = NA, box.padding = 0.4, seed = 42) +
scale_y_continuous(breaks = seq(1850, 2000, 50)) +
facet_grid(rows = vars(lake), cols = vars(name), scales = "free_x", switch = "x") +
theme_bw() +
theme(strip.background = element_blank(),
strip.text.x = element_text(vjust = -1),
panel.grid = element_blank(),
axis.title = element_blank())
