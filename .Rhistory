librarian::shelf(readxl,tidyverse,janitor)
data <- read_excel("2026 WL HABs Water Quality Data.xlsx")
glimpse(data)
## get separate df of units and MDLs
meta_dat <- data %>% select(contains(c("Units","MDL")))
View(meta_dat)
## get separate df of units and MDLs
meta_dat <- data %>% select(contains(c("Units","MDL"))) %>% distinct()
View(meta_dat)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct()
View(units)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer()
View(units)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=.)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=all_of())
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9)
View(units)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = grepl(" Unit",""))
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = grepl(analyte," Unit",""))
View(units)
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units")
?grepl
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = gsub(analyte," Unit",""))
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = gsub(" Unit","",analyte))
View(units)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = gsub(" Units","",analyte))
View(units)
## get separate df of units and MDLs
units <- data %>% select(contains("Units")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="units") %>% mutate(analyte = gsub(" Units","",analyte)) %>%
drop_na()
View(units)
View(data)
mdls <- data %>% select(contains("MDL")) %>% distinct()
View(mdls)
mdls <- data %>% select(contains("MDL")) %>% distinct() %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="mdl") %>% mutate(analyte = gsub(" MDL","",analyte))
View(mdls)
glimpse(mdls)
mdls <- data %>% select(contains("MDL")) %>% distinct() %>% mutate(1:9,as_character())
mdls <- data %>% select(contains("MDL")) %>% distinct() %>% mutate(c(1:9),as_character())
mdls <- data %>% select(contains("MDL")) %>% distinct() %>% mutate(across(1:9),as_character())
mdls <- data %>% select(contains("MDL")) %>% distinct() %>% mutate(across(everything(),as.numeric))
View(mdls)
mdls <- data %>% select(contains("MDL")) %>% distinct() %>% mutate(across(everything(),as.numeric)) %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="mdl") %>% mutate(analyte = gsub(" MDL","",analyte)) %>%
drop_na()
View(mdls)
mdls <- data %>% select(contains("MDL")) %>% mutate(across(everything(),as.numeric)) %>%
pivot_longer(cols=1:9,names_to="analyte",values_to="mdl") %>% distinct() %>%
mutate(analyte = gsub(" MDL","",analyte)) %>%
drop_na()
View(mdls)
meta_dat <- units %>% left_join(mdls)
View(meta_dat)
#just chemistry
chem <- data %>% select(!contains("Units", "MDL"))
#just chemistry
chem <- data %>% select(!contains(c("Units", "MDL")))
View(chem)
#just chemistry
chem <- data %>% select(!contains(c("Units", "MDL", "Timestamp","LOD")))
View(chem)
#just chemistry
chem <- data %>% select(!contains(c("Units","MDL","Timestamp","LOD","Comments")))
View(chem)
glimpse(chem)
chem_long <- chem %>% pivot_longer(cols=TP:Micro,names_to=analyte)
chem_long <- chem %>% pivot_longer(cols=TP:Micro,names_to="analyte")
View(chem_long)
glimpse(chem_long)
chem_long <- chem %>% pivot_longer(cols=TP:Micro,names_to="analyte") %>% janitor::clean_names()
glimpse(chem_long)
## box plots by lake and depth
ggplot(chem_long,aes(x=lake,y=value,fill=sample_depth))+
geom_boxplot()
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot()
unique(chem_long$sample_name)
#fix non-unique lake names
chem_long <- chem_long %>% mutate(sample_name = case_when(sample_name=="Vermillion" ~ "Vermilion",
sample_name=="Cresent" ~ "Crescent",
sample_name=="Lower Red Central" ~ "Lower Red",
sample_name=="Four Mile" ~ "Fourmile",
T ~ sample_name))
unique(chem_long$sample_name)
length(unique(chem_long$sample_name))
#change lake depth to all lowercase
chem_long <- chem_long %>% mutate(sample_depth = tolower(sample_depth))
unique(chem_long$sample_depth)
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot()
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=0))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=0.5))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=-1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=0))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
facet_wrap(~analyte)+
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot() +
facet_wrap(~analyte,scales="free_y")+
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=1))
## box plots by lake and depth
ggplot(chem_long,aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot(outliers=F) +
facet_wrap(~analyte,scales="free_y")+
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=1))
View(chem_long)
## box plots by lake and depth
chem_long %>% select(!sample_type) %>% drop_na %>%
ggplot(aes(x=sample_name,y=value,fill=sample_depth))+
geom_boxplot(outliers=F) +
facet_wrap(~analyte,scales="free_y")+
theme(axis.text.x=element_text(angle=45,vjust=1,hjust=1))
### vermilion over time
chem_long %>% filter(sample_name=="Vermilion") %>%
ggplot(aes(x=collection_date,y=value,color=sample_depth))+
geom_point()+
facet_wrap(~analyte,scales="free_y")
### vermilion over time
chem_long %>% filter(sample_name=="Vermilion") %>% select(!sample_type) %>% drop_na %>%
ggplot(aes(x=collection_date,y=value,color=sample_depth))+
geom_point()+
facet_wrap(~analyte,scales="free_y")
### vermilion over time
chem_long %>% filter(sample_name=="Vermilion") %>% select(!sample_type) %>% drop_na %>%
ggplot(aes(x=collection_date,y=value,color=sample_depth))+
geom_point()+
geom_line()+
facet_wrap(~analyte,scales="free_y")
