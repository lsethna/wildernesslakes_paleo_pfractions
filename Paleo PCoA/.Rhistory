#read in master data
master_dat <- read.csv("/Users/lsethna/Documents/GitHub/wildernesslakes_paleo_pfractions/raw_data/WL_paleo_masterdataset_20Nov2024.csv") %>%
select(!X)
## ------------------------------------------------------------ ##
